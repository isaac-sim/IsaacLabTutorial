#usda 1.0
(
    defaultPrim = "Vial"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Vial" (
    prepend references = @vial.usda@</Vial>
)
{
    def Mesh "Label" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 14, 13, 1, 2, 15, 14, 2, 3, 16, 15, 3, 4, 17, 16, 4, 5, 18, 17, 5, 6, 19, 18, 6, 7, 20, 19, 7, 8, 21, 20, 8, 9, 22, 21, 9, 10, 23, 22, 10, 11, 24, 23, 11, 12, 25, 24]
        rel material:binding = </Vial/Looks/Label>
        point3f[] points = [(0.0118826255, -0.008483114, 0.016), (0.012694271, -0.007212176, 0.016), (0.013370491, -0.005864297, 0.016), (0.0139040705, -0.004453856, 0.016), (0.014289317, -0.0029959, 0.016), (0.014522121, -0.0015059832, 0.016), (0.0146, 0, 0.016), (0.014522121, 0.0015059832, 0.016), (0.014289317, 0.0029959, 0.016), (0.0139040705, 0.004453856, 0.016), (0.013370491, 0.005864297, 0.016), (0.012694271, 0.007212176, 0.016), (0.0118826255, 0.008483114, 0.016), (0.0118826255, -0.008483114, 0.076), (0.012694271, -0.007212176, 0.076), (0.013370491, -0.005864297, 0.076), (0.0139040705, -0.004453856, 0.076), (0.014289317, -0.0029959, 0.076), (0.014522121, -0.0015059832, 0.076), (0.0146, 0, 0.076), (0.014522121, 0.0015059832, 0.076), (0.014289317, 0.0029959, 0.076), (0.0139040705, 0.004453856, 0.076), (0.013370491, 0.005864297, 0.076), (0.012694271, 0.007212176, 0.076), (0.0118826255, 0.008483114, 0.076)]
        uniform token subdivisionScheme = "none"
    }

    over "Looks"
    {
        def Material "Label"
        {
            token outputs:surface.connect = </Vial/Looks/Label/PreviewShader.outputs:surface>

            def Shader "PreviewShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.86)
                token outputs:surface
            }
        }
    }
}

